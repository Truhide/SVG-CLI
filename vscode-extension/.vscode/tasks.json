{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tsc: build",
      "type": "shell",
      "command": "node",
      "args": ["../node_modules/typescript/bin/tsc", "-p", "tsconfig.json"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent", "clear": true }
    }
  ]
}
