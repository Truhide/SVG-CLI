{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行扩展 (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-workspace-trust",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "tsc: build"
    }
  ]
}
